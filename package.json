{
  "name": "stoopidlink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:pages": "node tools/build-pages.mjs",
    "check:build": "node tools/check-build.mjs",
